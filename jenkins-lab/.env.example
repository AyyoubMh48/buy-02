# Match the existing PostgreSQL password when reusing its volume.
SONAR_DB_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD
# Defaults preserve the discovered sonar-lab volumes.
SONAR_POSTGRES_VOLUME=sonar-lab_sonar_postgres_data
SONAR_DATA_VOLUME=sonar-lab_sonar_data
SONAR_LOGS_VOLUME=sonar-lab_sonar_logs
SONAR_EXTENSIONS_VOLUME=sonar-lab_sonar_extensions
