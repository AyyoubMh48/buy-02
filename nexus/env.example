# Example names only. Store real values outside the checkout or in nexus/secrets/.
# Load a private copy with: set -a; source /private/path/nexus.env; set +a
NEXUS_URL=http://127.0.0.1:8081
NEXUS_ADMIN_USERNAME=admin
# Set passwords with read -rsp prompts; do not put real passwords in this file.
NEXUS_ADMIN_PASSWORD=
NEXUS_READ_USERNAME=buy02-reader
NEXUS_READ_PASSWORD=
NEXUS_READ_EMAIL=
NEXUS_PUBLISH_USERNAME=buy02-publisher
NEXUS_PUBLISH_PASSWORD=
NEXUS_PUBLISH_EMAIL=
# Optional REST-client CA bundle for an internal HTTPS certificate authority.
# NEXUS_CA_BUNDLE=/private/path/ca.pem
# Optional absolute executable path; otherwise the existing service mvnw is used.
# MAVEN_BIN=/usr/bin/mvn
# Optional isolated Maven dependency cache; avoid changing global Maven settings.
# NEXUS_MAVEN_CACHE=/tmp/buy02-maven-cache
