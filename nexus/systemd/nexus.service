[Unit]
Description=Nexus Repository Manager for buy-02 Maven artifacts
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=900
StartLimitBurst=3

[Service]
Type=simple
User=nexus
Group=nexus
WorkingDirectory=/opt/nexus
ExecStart=/opt/nexus/bin/nexus run
ExecStartPost=/usr/local/libexec/nexus-healthcheck --wait
Restart=on-failure
RestartSec=20
TimeoutStartSec=650
TimeoutStopSec=180
SuccessExitStatus=143
LimitNOFILE=65536
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
# Java FileStore can mistake a same-device writable bind mount for a read-only
# root filesystem. Keep / writable at mount level, protecting directories below.
ProtectSystem=full
ReadOnlyPaths=/opt /var /mnt /media /srv /run
ReadWritePaths=/var/lib/nexus

[Install]
WantedBy=multi-user.target
